# ============================================
# 环境变量配置示例
# 复制此文件为 .env 并填写实际值
# ============================================

# 数据库配置
DB_NAME=security_monitor
DB_USER=postgres
# 数据库密码（必填，至少 12 位；只在数据库首次初始化时生效，之后修改需进库执行 ALTER USER）
DB_PASSWORD=

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# 飞书配置
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
FEISHU_SECRET=your-secret-key

# 应用配置
LOG_LEVEL=INFO

# 安全配置
# JWT 签名密钥（必填，至少 32 位随机字符串），生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 凭据加密密钥（必填，至少 32 位；设置后不要更换，否则已保存的 SSH 密码 / SNMP 团体字无法解密）
CREDENTIAL_KEY=
# 允许跨域的前端地址，逗号分隔；通过 nginx 同源访问时留空即可
CORS_ORIGINS=

# 登录防爆破：同一账号连续失败次数上限、锁定分钟数
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# 操作审计日志保留天数
AUDIT_RETENTION_DAYS=180

# 告警历史保留天数（登录日志、高危操作等原始日志按系统设置中的“日志保留天数”）
ALERT_RETENTION_DAYS=365
